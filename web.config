<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for the RBS Resolver static site.

  IIS does not serve unknown file extensions by default — without these MIME
  mappings, requests for SPEC.md and the workbook fixtures return HTTP 404.3
  ("MIME type not configured"). The mappings below match the file types
  shipped from the repo.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
      <mimeMap fileExtension=".xlsx" mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
